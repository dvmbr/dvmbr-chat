{
  "name": "dvmbr-chat",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "dev": "concurrently -n web,socket -c cyan,green \"pnpm dev:web\" \"pnpm dev:socket\"",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "prisma:studio": "pnpm --filter web prisma:studio",
    "prisma:migrate": "pnpm --filter web prisma:migrate",
    "prisma:generate": "pnpm --filter web prisma:generate",
    "prisma:reset": "pnpm --filter web prisma:reset",
    "dev:socket": "pnpm --filter socket-server dev",
    "build:socket": "pnpm --filter socket-server build",
    "start:socket": "pnpm --filter socket-server start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.0.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript-eslint": "^8.59.2"
  }
}