{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@dvmbr/shared/*": ["../../packages/shared/src/*.ts"]
    }
